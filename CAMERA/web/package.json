  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vite": "7.1.5",
    "vitest": "3.2.4",
    "ws": "8.18.3"
  }
}
