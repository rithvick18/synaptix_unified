# Player observation service settings. Copy to service/.env (read from the working
# directory when running `python -m app` in service/) or export as environment variables.
# No secrets are required. Values shown are the defaults.

# Bind locally by default. Only change this if you understand the exposure.
OBS_HOST=127.0.0.1
OBS_PORT=8765

# Exact origins allowed for CORS and WebSocket upgrades (JSON list, no wildcards).
# 5173 = Memoria 3D dev server, 5174 = this repo's demo.
OBS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]'
# Non-browser clients send no Origin header. Keep false; the integration check sets one.
OBS_ALLOW_MISSING_ORIGIN=false
# Optional shared key required as header X-Session-Create-Key on POST /v1/sessions.
# Leave unset for local development. If you set one, do not commit it.
# OBS_SESSION_CREATE_KEY=

# Sessions (in memory, single worker only; all sessions are lost on restart)
OBS_MAX_SESSIONS=50
OBS_SESSION_IDLE_TTL_S=900
OBS_SESSION_MAX_AGE_S=14400

# Payload and rate limits
OBS_MAX_BODY_BYTES=16384
OBS_MAX_WS_MESSAGE_BYTES=16384
OBS_OBSERVATION_RATE_PER_S=40
OBS_OBSERVATION_BURST=80
OBS_GAME_EVENT_RATE_PER_S=20
OBS_GAME_EVENT_BURST=200

# Timing
OBS_HELLO_TIMEOUT_S=5
OBS_TICK_INTERVAL_S=0.25
OBS_HEARTBEAT_INTERVAL_S=2
OBS_STATE_MIN_INTERVAL_S=0.1

# Policy thresholds: initial, tunable defaults (ms unless noted). Nested with "__".
OBS_POLICY__STALE_AFTER_MS=1500
OBS_POLICY__PRODUCER_TAKEOVER_AFTER_MS=3000
OBS_POLICY__GESTURE_MAX_AGE_MS=5000
OBS_POLICY__DELAY_INSTRUCTION_AFTER_MS=1500
OBS_POLICY__MAX_INSTRUCTION_HOLD_MS=8000
OBS_POLICY__DELAY_INSTRUCTION_COOLDOWN_MS=5000
OBS_POLICY__CUE_HEAD_AWAY_MS=6000
OBS_POLICY__CUE_INACTIVITY_MS=10000
OBS_POLICY__CUE_MAX_PER_TASK=1
OBS_POLICY__CUE_COOLDOWN_MS=60000
OBS_POLICY__HINT_ERROR_WINDOW=6
OBS_POLICY__HINT_MIN_ERRORS=2
OBS_POLICY__HINT_MIN_PRIOR_ANSWERS=2
OBS_POLICY__HINT_SLOWDOWN_RATIO=1.25
OBS_POLICY__HINT_MAX_PER_TASK=1
OBS_POLICY__HINT_COOLDOWN_MS=30000
OBS_POLICY__DIFFICULTY_SUCCESS_STREAK=5
OBS_POLICY__DIFFICULTY_SLOWDOWN_TOLERANCE=1.1
OBS_POLICY__DIFFICULTY_COOLDOWN_MS=180000
OBS_POLICY__ENGAGEMENT_MIN_ANSWERS=3
OBS_POLICY__ENGAGEMENT_MIN_COMPLETED_TASKS=2
OBS_POLICY__ENGAGEMENT_WINDOW_ANSWERS=10
OBS_POLICY__ENGAGEMENT_VISION_WINDOW_MS=120000
OBS_POLICY__ENGAGEMENT_MIN_VISION_COVERAGE=0.5
OBS_POLICY__ACTION_TTL_MS=15000
