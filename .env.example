# Memoria Unified — local settings for `npm run dev`. Copy to .env (git-ignored).
# No secrets are needed. Values shown are the defaults. Environment variables win over this file.

# --- Game (3D game, Vite dev server) -------------------------------------------------
# The port Memoria 3D is served on. The launcher adds it to the service's allowed origins.
MEMORIA_GAME_PORT=5173
# Where the game finds the observation service. Must be loopback (127.0.0.1, localhost,
# [::1]); anything else is refused by the game (src/camera/integration.ts).
VITE_OBSERVATION_URL=http://127.0.0.1:8765
# Also start the standalone camera app on http://127.0.0.1:5174 (same as `npm run dev:debug`).
MEMORIA_WITH_CAMERA_APP=0

# --- Observation service (CAMERA/service) --------------------------------------------
# Loopback only by default. Do not change unless you understand the exposure.
OBS_HOST=127.0.0.1
OBS_PORT=8765
# Exact origins allowed for CORS and WebSocket upgrades (JSON list, no wildcards).
# Leave unset and the launcher derives it from MEMORIA_GAME_PORT plus the camera app (5174).
# OBS_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]'

# Service policy thresholds (ms unless noted). Full list: CAMERA/.env.example.
# OBS_POLICY__DELAY_INSTRUCTION_AFTER_MS=1500
# OBS_POLICY__MAX_INSTRUCTION_HOLD_MS=8000
# OBS_POLICY__CUE_HEAD_AWAY_MS=6000
# OBS_POLICY__CUE_INACTIVITY_MS=10000
# OBS_POLICY__HINT_MIN_ERRORS=2
# OBS_POLICY__HINT_SLOWDOWN_RATIO=1.25
